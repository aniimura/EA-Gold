//@version=6
// =============================================================================================
//  XAU Multi-Speed Volatility-Scaled Donchian Trend
//  -------------------------------------------------------------------------------------------
//  Research hypothesis only. This is NOT a claim of profitability.
//  Three independent Donchian "sleeves" (fast / medium / slow) are tracked virtually.
//  Their signed target sizes are summed into ONE net broker position, because Pine strategies
//  are single-position (netting) engines and cannot hold independent long+short positions.
//
//  DESIGN RULES ENFORCED IN THIS SCRIPT
//    * Every breakout / exit channel EXCLUDES the current bar  -> ta.highest(high[1], len)
//    * Signals are only evaluated on CONFIRMED bars            -> barstate.isconfirmed
//    * process_orders_on_close = false                         -> fills at the NEXT bar's open
//    * calc_on_every_tick = false                              -> no intrabar recalculation
//    * Position size derives from stop distance, never fixed lots
//    * No lookahead, no request.security(), no future data, no repainting sources
//
//  Intended chart: XAUUSD, 4H (240). A warning is drawn on any other timeframe.
// =============================================================================================

strategy(
     title                        = "XAU Multi-Speed Volatility-Scaled Donchian Trend",
     shorttitle                   = "XAU MS-VSD",
     overlay                      = true,
     pyramiding                   = 100,              // we submit raw deltas via strategy.order()
     initial_capital              = 100000,
     currency                     = currency.USD,     // account currency assumed USD
     default_qty_type             = strategy.fixed,
     default_qty_value            = 1,                // never used: qty is always passed explicitly
     calc_on_every_tick           = false,            // evaluate only on completed bars
     calc_on_order_fills          = false,
     process_orders_on_close      = false,            // order sent at bar close fills at next open
     close_entries_rule           = "FIFO",
     commission_type              = strategy.commission.cash_per_contract,
     commission_value             = 0.035,            // USD per OUNCE per side (= $3.50 / 100oz lot / side)
     slippage                     = 15,               // in TICKS. Check syminfo.mintick for your feed.
     margin_long                  = 0.0,
     margin_short                 = 0.0,
     fill_orders_on_standard_ohlc = true,             // ignore Heikin-Ashi style synthetic prices
     max_labels_count             = 200)

// =============================================================================================
// 1. INPUTS
// =============================================================================================

// --- 1.1 Sleeve Donchian windows -------------------------------------------------------------
// Defaults are the specified research parameters. Changing them is a deliberate act by the user;
// the script never adapts, optimises or overrides them.
var string GW = "Sleeve windows (Donchian, current bar excluded)"
fastEntryLen = input.int(20,  "Fast   - entry window",  minval = 2, group = GW)
fastExitLen  = input.int(10,  "Fast   - exit window",   minval = 1, group = GW)
medEntryLen  = input.int(55,  "Medium - entry window",  minval = 2, group = GW)
medExitLen   = input.int(20,  "Medium - exit window",   minval = 1, group = GW)
slowEntryLen = input.int(120, "Slow   - entry window",  minval = 2, group = GW)
slowExitLen  = input.int(40,  "Slow   - exit window",   minval = 1, group = GW)

useFast = input.bool(true, "Enable Fast sleeve",   group = GW)
useMed  = input.bool(true, "Enable Medium sleeve", group = GW)
useSlow = input.bool(true, "Enable Slow sleeve",   group = GW)

// --- 1.2 Risk / sizing -----------------------------------------------------------------------
var string GR = "Risk and position sizing"
riskPct      = input.float(0.10, "Risk % of equity per sleeve", minval = 0.0,  maxval = 5.0, step = 0.01, group = GR,
                 tooltip = "0.10 % per sleeve. When all three sleeves align the combined INITIAL risk is about 0.30 %.")
atrLen       = input.int(20,     "ATR length (4H bars)",         minval = 1,     group = GR)
atrMult      = input.float(2.5,  "ATR stop multiplier",          minval = 0.1,   step = 0.1,   group = GR)
contractOz   = input.float(100,  "Contract size (ounces / lot)", minval = 0.01,  step = 1,     group = GR)
lotStep      = input.float(0.01, "Minimum lot increment",        minval = 0.001, step = 0.001, group = GR)
maxNotionalX = input.float(1.5,  "Max net notional (x equity)",  minval = 0.1,   step = 0.1,   group = GR,
                 tooltip = "abs(net lots) * ounces per lot * price  <=  equity * this multiple.")

// --- 1.3 Behaviour ---------------------------------------------------------------------------
var string GB = "Behaviour"
allowReversal = input.bool(true, "Allow a sleeve to reverse on its exit bar", group = GB,
                 tooltip = "If a close both breaks the exit channel AND the opposite entry channel, the sleeve may flip on the same signal bar. The flip still fills at the next bar's open.")
strictTf      = input.bool(true, "Block NEW entries if timeframe is not 4H", group = GB,
                 tooltip = "Exits and protective-stop processing are NEVER blocked.")

// --- 1.4 Friday / weekly-close filter --------------------------------------------------------
var string GF = "Weekly close filter"
useFriday   = input.bool(true, "Block new sleeves late Friday", group = GF)
fridayHour  = input.int(13, "Friday cut-off hour (New York time)", minval = 0, maxval = 23, group = GF,
                 tooltip = "No NEW sleeve may be initiated from this hour onward on Friday, New York time. Open sleeves keep running and all exits stay active.")

// --- 1.5 Manual news blackout windows --------------------------------------------------------
// Pine has NO reliable forward economic calendar. Nothing is fabricated here.
// You supply the windows yourself (or your execution layer disables the strategy externally).
// CPI / PCE / NFP / FOMC windows should normally come from an external calendar feed.
var string GN = "Manual news blackout (entries only, never exits)"
nbUse = input.bool(false, "Enable manual news blackout", group = GN)
nb1On = input.bool(false, "Window 1", inline = "n1", group = GN)
nb1S  = input.time(timestamp("2026-01-01T12:00:00+0000"), "from", inline = "n1", group = GN)
nb1E  = input.time(timestamp("2026-01-01T14:00:00+0000"), "to",   inline = "n1", group = GN)
nb2On = input.bool(false, "Window 2", inline = "n2", group = GN)
nb2S  = input.time(timestamp("2026-01-02T12:00:00+0000"), "from", inline = "n2", group = GN)
nb2E  = input.time(timestamp("2026-01-02T14:00:00+0000"), "to",   inline = "n2", group = GN)
nb3On = input.bool(false, "Window 3", inline = "n3", group = GN)
nb3S  = input.time(timestamp("2026-01-03T12:00:00+0000"), "from", inline = "n3", group = GN)
nb3E  = input.time(timestamp("2026-01-03T14:00:00+0000"), "to",   inline = "n3", group = GN)
nb4On = input.bool(false, "Window 4", inline = "n4", group = GN)
nb4S  = input.time(timestamp("2026-01-04T12:00:00+0000"), "from", inline = "n4", group = GN)
nb4E  = input.time(timestamp("2026-01-04T14:00:00+0000"), "to",   inline = "n4", group = GN)
nb5On = input.bool(false, "Window 5", inline = "n5", group = GN)
nb5S  = input.time(timestamp("2026-01-05T12:00:00+0000"), "from", inline = "n5", group = GN)
nb5E  = input.time(timestamp("2026-01-05T14:00:00+0000"), "to",   inline = "n5", group = GN)
nb6On = input.bool(false, "Window 6", inline = "n6", group = GN)
nb6S  = input.time(timestamp("2026-01-06T12:00:00+0000"), "from", inline = "n6", group = GN)
nb6E  = input.time(timestamp("2026-01-06T14:00:00+0000"), "to",   inline = "n6", group = GN)
nb7On = input.bool(false, "Window 7", inline = "n7", group = GN)
nb7S  = input.time(timestamp("2026-01-07T12:00:00+0000"), "from", inline = "n7", group = GN)
nb7E  = input.time(timestamp("2026-01-07T14:00:00+0000"), "to",   inline = "n7", group = GN)
nb8On = input.bool(false, "Window 8", inline = "n8", group = GN)
nb8S  = input.time(timestamp("2026-01-08T12:00:00+0000"), "from", inline = "n8", group = GN)
nb8E  = input.time(timestamp("2026-01-08T14:00:00+0000"), "to",   inline = "n8", group = GN)

// --- 1.6 Informational cost assumptions ------------------------------------------------------
// These do NOT affect fills. Real costs come from the strategy() header + the Properties tab.
// TradingView does not publish a trustworthy historical bid/ask series for XAUUSD, so no
// synthetic spread series is generated here.
var string GC = "Cost assumptions (informational display only)"
infoSpread    = input.float(0.30,  "Assumed round-turn spread (USD/oz)", minval = 0, step = 0.01, group = GC)
infoSlipTicks = input.int(15,      "Slippage set in Properties (ticks)", minval = 0, group = GC,
                 tooltip = "Mirror the 'slippage' value from the strategy Properties tab so the dashboard can show its USD/oz equivalent. Display only.")
infoCommOz    = input.float(0.035, "Commission set in Properties (USD/oz/side)", minval = 0, step = 0.001, group = GC)

// --- 1.7 Visuals ------------------------------------------------------------------------------
var string GV = "Visuals"
showEntryCh = input.bool(true, "Plot entry channels", group = GV)
showExitCh  = input.bool(true, "Plot exit channels",  group = GV)
showStops   = input.bool(true, "Plot sleeve protective stops", group = GV)
showMarkers = input.bool(true, "Plot entry / exit markers", group = GV)
showTable   = input.bool(true, "Show dashboard table", group = GV)

// --- 1.8 Debug export ---------------------------------------------------------------------------
// Machine-readable series for bar-by-bar reconciliation against the Python engine.
// Purely additive: these are plots, they place no orders and change no state, so a
// debug run and a normal run produce identical trades.
var string GD = "Debug export (reconciliation)"
dbgOn = input.bool(false, "Enable debug export series", group = GD,
         tooltip = "Turn on, then use the chart menu -> Export chart data... to write a CSV. Feed that file to:  python bt_xau_msvsd.py --reconcile <file.csv> --friday-basis close")

// =============================================================================================
// 2. SHARED CALCULATIONS
// =============================================================================================

// Volatility. Computed on the completed bar only; it is frozen into each sleeve at entry.
atrVal = ta.atr(atrLen)

// A signal may only be produced by a CONFIRMED (completed) bar.
// On historical bars this is always true; on the live bar it becomes true at bar close.
canSignal = barstate.isconfirmed

// --- 2.1 Timeframe guard -----------------------------------------------------------------------
isCorrectTf = timeframe.period == "240"
tfBlocked   = strictTf and not isCorrectTf

// --- 2.2 Weekly close filter -------------------------------------------------------------------
// Evaluated on the SIGNAL bar's close timestamp, in New York time.
nyDow  = dayofweek(time_close, "America/New_York")
nyHour = hour(time_close, "America/New_York")
fridayBlocked = useFriday and nyDow == dayofweek.friday and nyHour >= fridayHour

// --- 2.3 Manual news blackout -------------------------------------------------------------------
var array<bool> nbOn = array.from(nb1On, nb2On, nb3On, nb4On, nb5On, nb6On, nb7On, nb8On)
var array<int>  nbS  = array.from(nb1S,  nb2S,  nb3S,  nb4S,  nb5S,  nb6S,  nb7S,  nb8S)
var array<int>  nbE  = array.from(nb1E,  nb2E,  nb3E,  nb4E,  nb5E,  nb6E,  nb7E,  nb8E)

newsBlocked = false
if nbUse
    for i = 0 to 7
        if array.get(nbOn, i) and time_close >= array.get(nbS, i) and time_close <= array.get(nbE, i)
            newsBlocked := true

// --- 2.4 Aggregate entry gate --------------------------------------------------------------------
// IMPORTANT: this gate touches ENTRIES ONLY. Channel exits and protective stops are processed
// unconditionally inside every sleeve, regardless of any filter below.
entriesBlocked = tfBlocked or fridayBlocked or newsBlocked
blockReason    = tfBlocked ? "Wrong timeframe (needs 4H)" : fridayBlocked ? "Friday >= " + str.tostring(fridayHour) + ":00 NY" : newsBlocked ? "Manual news blackout" : "-"

// --- 2.5 Donchian channels. CURRENT BAR IS EXCLUDED EVERYWHERE (high[1] / low[1]) -----------------
fEntHi = ta.highest(high[1], fastEntryLen)
fEntLo = ta.lowest(low[1],   fastEntryLen)
fExHi  = ta.highest(high[1], fastExitLen)
fExLo  = ta.lowest(low[1],   fastExitLen)

mEntHi = ta.highest(high[1], medEntryLen)
mEntLo = ta.lowest(low[1],   medEntryLen)
mExHi  = ta.highest(high[1], medExitLen)
mExLo  = ta.lowest(low[1],   medExitLen)

sEntHi = ta.highest(high[1], slowEntryLen)
sEntLo = ta.lowest(low[1],   slowEntryLen)
sExHi  = ta.highest(high[1], slowExitLen)
sExLo  = ta.lowest(low[1],   slowExitLen)

// Risk budget per sleeve, recomputed from live equity, consumed at the moment a sleeve enters.
riskCash = strategy.equity * riskPct / 100.0

// =============================================================================================
// 3. SLEEVE ENGINE
//    Pine gives every CALL SITE of a function its own copy of the function's `var` variables.
//    Calling sleeveStep() three times therefore produces three genuinely independent state
//    machines - closing or reversing one sleeve cannot touch the other two.
//
//    Event codes:  exitEv 0 = none, 3 = channel exit, 4 = protective stop
//                  entEv  0 = none, 1 = long entry,   2 = short entry
// =============================================================================================
sleeveStep(bool enabled, float entHi, float entLo, float exHi, float exLo, float atrNow, float mult, float rCash, float cOz, float lStep, bool blocked, bool ok, bool allowRev) =>
    var int   dir     = 0     // -1 short, 0 flat, +1 long  (this is the TARGET state)
    var float lots    = 0.0   // sleeve size in lots, frozen at entry
    var float entryPx = na    // ACTUAL fill price (recorded at the next bar's open)
    var float stopPx  = na    // initial protective stop, never widened, never trailed
    var float atrEnt  = na    // ATR frozen at the entry signal
    var int   pending = 0     // 1 = entry submitted last bar, fill happens at THIS bar's open

    exitEv = 0
    entEv  = 0

    // -- (A) Register the real fill of an entry submitted on the previous bar's close.
    //        The fill price is this bar's OPEN, which is already known and final. No lookahead.
    if pending == 1
        entryPx := open
        stopPx  := dir == 1 ? open - atrEnt * mult : open + atrEnt * mult
        pending := 0

    // -- (B) PROTECTIVE STOP (highest priority). The breach is detected on the COMPLETED bar's
    //        range; the flattening order is then submitted and fills at the NEXT bar's open.
    //        This is the conservative non-repainting approximation - see the limitations note.
    if dir != 0 and not na(stopPx) and ok
        breached = dir == 1 ? low <= stopPx : high >= stopPx
        if breached
            exitEv  := 4
            dir     := 0
            lots    := 0.0
            entryPx := na
            stopPx  := na
            atrEnt  := na

    // -- (C) DONCHIAN CHANNEL EXIT (only if the stop did not already fire on this bar)
    if exitEv == 0 and dir != 0 and ok and not na(exHi) and not na(exLo)
        chExit = dir == 1 ? close < exLo : close > exHi
        if chExit
            exitEv  := 3
            dir     := 0
            lots    := 0.0
            entryPx := na
            stopPx  := na
            atrEnt  := na

    // -- (D) ENTRY. Flat sleeves only: a sleeve holds at most one virtual position and never
    //        adds to an existing (winning or losing) one. Gated by the entry filters only.
    canEnter = enabled and dir == 0 and ok and not blocked and not na(entHi) and not na(entLo) and not na(atrNow) and atrNow > 0 and (exitEv == 0 or allowRev)
    if canEnter
        if close > entHi
            dir := 1
        else if close < entLo
            dir := -1
        if dir != 0
            atrEnt      := atrNow
            stopDist     = atrNow * mult                 // 2.5 x ATR
            riskPerLot   = stopDist * cOz                // USD lost per lot if the stop is hit
            rawLots      = riskPerLot > 0 ? rCash / riskPerLot : 0.0
            lots        := math.max(0.0, math.floor(rawLots / lStep + 1e-9) * lStep)  // round DOWN
            if lots <= 0
                dir    := 0                              // risk budget below one lot increment
                atrEnt := na
            else
                pending := 1
                entryPx := na                            // filled at next bar's open, see block A
                stopPx  := na
                entEv   := dir == 1 ? 1 : 2

    // A sleeve switched off in the settings is force-flattened so it stops contributing.
    if not enabled and dir != 0
        exitEv  := exitEv == 0 ? 3 : exitEv
        dir     := 0
        lots    := 0.0
        entryPx := na
        stopPx  := na
        atrEnt  := na
        pending := 0

    [dir, lots, entryPx, stopPx, atrEnt, exitEv, entEv]

// --- 3.1 Three independent instances --------------------------------------------------------------
[fDir, fLots, fEntry, fStop, fAtrE, fXev, fNev] = sleeveStep(useFast, fEntHi, fEntLo, fExHi, fExLo, atrVal, atrMult, riskCash, contractOz, lotStep, entriesBlocked, canSignal, allowReversal)
[mDir, mLots, mEntry, mStop, mAtrE, mXev, mNev] = sleeveStep(useMed,  mEntHi, mEntLo, mExHi, mExLo, atrVal, atrMult, riskCash, contractOz, lotStep, entriesBlocked, canSignal, allowReversal)
[sDir, sLots, sEntry, sStop, sAtrE, sXev, sNev] = sleeveStep(useSlow, sEntHi, sEntLo, sExHi, sExLo, atrVal, atrMult, riskCash, contractOz, lotStep, entriesBlocked, canSignal, allowReversal)

// =============================================================================================
// 4. NETTING -> ONE BROKER POSITION
//    Each sleeve keeps its own state. Only the SUM is sent to the broker, and only the DELTA
//    between the current position and the new net target is submitted. Opposing sleeves offset
//    each other internally, so no artificial spread is paid opening a hedged pair.
// =============================================================================================
netLotsRaw = fDir * fLots + mDir * mLots + sDir * sLots

// Aggregate exposure cap: abs(net lots) * oz per lot * price <= equity * multiple.
// The cap is evaluated on the signal bar's close while the fill is the next open, so it is an
// approximate ceiling rather than a hard guarantee.
capLots    = close > 0 ? (strategy.equity * maxNotionalX) / (contractOz * close) : 0.0
clipped    = math.min(math.abs(netLotsRaw), capLots)
netLots    = math.sign(netLotsRaw) * math.floor(clipped / lotStep + 1e-9) * lotStep  // proportional reduction
capApplied = math.abs(netLotsRaw) - math.abs(netLots) > lotStep / 2

targetQty = netLots * contractOz          // strategy qty is expressed in OUNCES
prevQty   = strategy.position_size
deltaQty  = targetQty - prevQty
minQty    = contractOz * lotStep * 0.5    // ignore sub-increment dust

// --- 4.1 Submit only the delta ---------------------------------------------------------------------
// Orders are issued on the confirmed bar's close. process_orders_on_close = false means they are
// executed at the OPEN of the following bar. No same-bar or optimised fill is ever used.
orderSent = false
if canSignal and math.abs(deltaQty) >= minQty
    orderSent := true
    if deltaQty > 0
        strategy.order("NET_BUY", strategy.long, qty = math.abs(deltaQty), comment = "net +" + str.tostring(deltaQty / contractOz, "#.###") + " lots")
    else
        strategy.order("NET_SELL", strategy.short, qty = math.abs(deltaQty), comment = "net -" + str.tostring(math.abs(deltaQty) / contractOz, "#.###") + " lots")

// =============================================================================================
// 5. ALERTS  (JSON payloads for webhook automation)
//    alertcondition() is not available inside strategy scripts, so alert() is used instead.
//    alert() also carries a dynamic message, which is what a webhook actually needs.
// =============================================================================================
nstr(float x) => na(x) ? "null" : str.tostring(x, "#.#####")

mkJson(string evType, string sleeve, float sStopPx, float sSize) =>
    '{"symbol":"'            + syminfo.tickerid +
     '","timeframe":"'       + timeframe.period +
     '","signal_bar_utc":"'  + str.format_time(time_close, "yyyy-MM-dd HH:mm:ss", "UTC") +
     '","signal_bar_ms":'    + str.tostring(time_close) +
     ',"event":"'            + evType +
     '","sleeve":"'          + sleeve +
     '","prev_net_qty_oz":'  + nstr(prevQty) +
     ',"target_net_qty_oz":' + nstr(targetQty) +
     ',"delta_qty_oz":'      + nstr(deltaQty) +
     ',"target_net_lots":'   + nstr(netLots) +
     ',"price":'             + nstr(close) +
     ',"atr":'               + nstr(atrVal) +
     ',"sleeve_stop":'       + nstr(sStopPx) +
     ',"sleeve_lots":'       + nstr(sSize) +
     ',"exec":"next_bar_open"}'

if canSignal
    // --- sleeve-level events
    if fNev == 1
        alert(mkJson("FAST_LONG_ENTRY", "FAST", na, fLots), alert.freq_once_per_bar_close)
    if fNev == 2
        alert(mkJson("FAST_SHORT_ENTRY", "FAST", na, fLots), alert.freq_once_per_bar_close)
    if fXev == 3
        alert(mkJson("FAST_EXIT", "FAST", na, 0.0), alert.freq_once_per_bar_close)
    if fXev == 4
        alert(mkJson("PROTECTIVE_STOP", "FAST", fStop[1], 0.0), alert.freq_once_per_bar_close)

    if mNev == 1
        alert(mkJson("MEDIUM_LONG_ENTRY", "MEDIUM", na, mLots), alert.freq_once_per_bar_close)
    if mNev == 2
        alert(mkJson("MEDIUM_SHORT_ENTRY", "MEDIUM", na, mLots), alert.freq_once_per_bar_close)
    if mXev == 3
        alert(mkJson("MEDIUM_EXIT", "MEDIUM", na, 0.0), alert.freq_once_per_bar_close)
    if mXev == 4
        alert(mkJson("PROTECTIVE_STOP", "MEDIUM", mStop[1], 0.0), alert.freq_once_per_bar_close)

    if sNev == 1
        alert(mkJson("SLOW_LONG_ENTRY", "SLOW", na, sLots), alert.freq_once_per_bar_close)
    if sNev == 2
        alert(mkJson("SLOW_SHORT_ENTRY", "SLOW", na, sLots), alert.freq_once_per_bar_close)
    if sXev == 3
        alert(mkJson("SLOW_EXIT", "SLOW", na, 0.0), alert.freq_once_per_bar_close)
    if sXev == 4
        alert(mkJson("PROTECTIVE_STOP", "SLOW", sStop[1], 0.0), alert.freq_once_per_bar_close)

    // --- one consolidated netting event describing the order actually sent
    if orderSent
        alert(mkJson("NET_POSITION_UPDATE", "NET", na, netLots), alert.freq_once_per_bar_close)

// =============================================================================================
// 6. VISUALS
// =============================================================================================
cFast = #26A69A
cMed  = #42A5F5
cSlow = #AB47BC

// --- 6.1 Entry channels (breakout levels, current bar excluded) ---------------------------------
plot(showEntryCh and useFast ? fEntHi : na, "Fast entry high",   color = color.new(cFast, 25), linewidth = 1)
plot(showEntryCh and useFast ? fEntLo : na, "Fast entry low",    color = color.new(cFast, 25), linewidth = 1)
plot(showEntryCh and useMed  ? mEntHi : na, "Medium entry high", color = color.new(cMed,  25), linewidth = 1)
plot(showEntryCh and useMed  ? mEntLo : na, "Medium entry low",  color = color.new(cMed,  25), linewidth = 1)
plot(showEntryCh and useSlow ? sEntHi : na, "Slow entry high",   color = color.new(cSlow, 25), linewidth = 2)
plot(showEntryCh and useSlow ? sEntLo : na, "Slow entry low",    color = color.new(cSlow, 25), linewidth = 2)

// --- 6.2 Exit channels ---------------------------------------------------------------------------
plot(showExitCh and useFast ? fExHi : na, "Fast exit high",   color = color.new(cFast, 65), style = plot.style_stepline)
plot(showExitCh and useFast ? fExLo : na, "Fast exit low",    color = color.new(cFast, 65), style = plot.style_stepline)
plot(showExitCh and useMed  ? mExHi : na, "Medium exit high", color = color.new(cMed,  65), style = plot.style_stepline)
plot(showExitCh and useMed  ? mExLo : na, "Medium exit low",  color = color.new(cMed,  65), style = plot.style_stepline)
plot(showExitCh and useSlow ? sExHi : na, "Slow exit high",   color = color.new(cSlow, 65), style = plot.style_stepline)
plot(showExitCh and useSlow ? sExLo : na, "Slow exit low",    color = color.new(cSlow, 65), style = plot.style_stepline)

// --- 6.3 Active protective stops -------------------------------------------------------------------
plot(showStops and fDir != 0 ? fStop : na, "Fast stop",   color = color.new(color.red,    20), style = plot.style_linebr, linewidth = 1)
plot(showStops and mDir != 0 ? mStop : na, "Medium stop", color = color.new(color.orange, 20), style = plot.style_linebr, linewidth = 1)
plot(showStops and sDir != 0 ? sStop : na, "Slow stop",   color = color.new(color.maroon, 20), style = plot.style_linebr, linewidth = 2)

// --- 6.4 Signal markers -----------------------------------------------------------------------------
plotshape(showMarkers and fNev == 1, "Fast long",  shape.triangleup,   location.belowbar, cFast, size = size.tiny,  text = "F")
plotshape(showMarkers and fNev == 2, "Fast short", shape.triangledown, location.abovebar, cFast, size = size.tiny,  text = "F")
plotshape(showMarkers and mNev == 1, "Med long",   shape.triangleup,   location.belowbar, cMed,  size = size.tiny,  text = "M")
plotshape(showMarkers and mNev == 2, "Med short",  shape.triangledown, location.abovebar, cMed,  size = size.tiny,  text = "M")
plotshape(showMarkers and sNev == 1, "Slow long",  shape.triangleup,   location.belowbar, cSlow, size = size.small, text = "S")
plotshape(showMarkers and sNev == 2, "Slow short", shape.triangledown, location.abovebar, cSlow, size = size.small, text = "S")

plotshape(showMarkers and (fXev == 3 or mXev == 3 or sXev == 3), "Channel exit", shape.xcross, location.abovebar, color.gray, size = size.tiny)
plotshape(showMarkers and (fXev == 4 or mXev == 4 or sXev == 4), "Stop exit",    shape.xcross, location.belowbar, color.red,  size = size.small)

// --- 6.5 Timeframe warning ---------------------------------------------------------------------------
var label warnLbl = na
if barstate.islast
    label.delete(warnLbl)
    if not isCorrectTf
        warnTxt = "WARNING: designed for the 4H (240) XAUUSD chart.\nCurrent timeframe: " + timeframe.period + (strictTf ? "\nNew entries are BLOCKED." : "\nEntries still allowed - this is not the intended design.")
        warnLbl := label.new(bar_index, high, warnTxt, style = label.style_label_down, color = color.new(color.red, 10), textcolor = color.white, size = size.normal)

// =============================================================================================
// 7. DASHBOARD
// =============================================================================================
stateTxt(int d) => d == 1 ? "LONG" : d == -1 ? "SHORT" : "flat"
stateCol(int d) => d == 1 ? color.new(color.green, 60) : d == -1 ? color.new(color.red, 60) : color.new(color.gray, 80)

var table dash = table.new(position.top_right, 6, 8, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 50))

if showTable and barstate.islast
    netNotional = math.abs(strategy.position_size) * close
    notionalCap = strategy.equity * maxNotionalX
    hdrC = color.new(color.blue, 70)

    table.cell(dash, 0, 0, "Sleeve", bgcolor = hdrC, text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 0, "State",  bgcolor = hdrC, text_color = color.white, text_size = size.small)
    table.cell(dash, 2, 0, "Lots",   bgcolor = hdrC, text_color = color.white, text_size = size.small)
    table.cell(dash, 3, 0, "Stop",   bgcolor = hdrC, text_color = color.white, text_size = size.small)
    table.cell(dash, 4, 0, "Entry",  bgcolor = hdrC, text_color = color.white, text_size = size.small)
    table.cell(dash, 5, 0, "ATR@in", bgcolor = hdrC, text_color = color.white, text_size = size.small)

    table.cell(dash, 0, 1, "FAST 20/10",   text_size = size.small, text_color = cFast)
    table.cell(dash, 1, 1, stateTxt(fDir), text_size = size.small, bgcolor = stateCol(fDir))
    table.cell(dash, 2, 1, str.tostring(fLots, "#.##"), text_size = size.small)
    table.cell(dash, 3, 1, nstr(fStop),  text_size = size.small)
    table.cell(dash, 4, 1, nstr(fEntry), text_size = size.small)
    table.cell(dash, 5, 1, nstr(fAtrE),  text_size = size.small)

    table.cell(dash, 0, 2, "MED 55/20",    text_size = size.small, text_color = cMed)
    table.cell(dash, 1, 2, stateTxt(mDir), text_size = size.small, bgcolor = stateCol(mDir))
    table.cell(dash, 2, 2, str.tostring(mLots, "#.##"), text_size = size.small)
    table.cell(dash, 3, 2, nstr(mStop),  text_size = size.small)
    table.cell(dash, 4, 2, nstr(mEntry), text_size = size.small)
    table.cell(dash, 5, 2, nstr(mAtrE),  text_size = size.small)

    table.cell(dash, 0, 3, "SLOW 120/40",  text_size = size.small, text_color = cSlow)
    table.cell(dash, 1, 3, stateTxt(sDir), text_size = size.small, bgcolor = stateCol(sDir))
    table.cell(dash, 2, 3, str.tostring(sLots, "#.##"), text_size = size.small)
    table.cell(dash, 3, 3, nstr(sStop),  text_size = size.small)
    table.cell(dash, 4, 3, nstr(sEntry), text_size = size.small)
    table.cell(dash, 5, 3, nstr(sAtrE),  text_size = size.small)

    table.cell(dash, 0, 4, "ATR(" + str.tostring(atrLen) + ")", text_size = size.small)
    table.cell(dash, 1, 4, str.tostring(atrVal, "#.##"), text_size = size.small)
    table.cell(dash, 2, 4, "Target lots", text_size = size.small)
    table.cell(dash, 3, 4, str.tostring(netLots, "#.##") + (capApplied ? " (capped)" : ""), text_size = size.small)
    table.cell(dash, 4, 4, "Position oz", text_size = size.small)
    table.cell(dash, 5, 4, str.tostring(strategy.position_size, "#.##"), text_size = size.small)

    table.cell(dash, 0, 5, "Net notional", text_size = size.small)
    table.cell(dash, 1, 5, str.tostring(netNotional, "#"), text_size = size.small)
    table.cell(dash, 2, 5, "Cap (" + str.tostring(maxNotionalX, "#.#") + "x eq)", text_size = size.small)
    table.cell(dash, 3, 5, str.tostring(notionalCap, "#"), text_size = size.small)
    table.cell(dash, 4, 5, "Equity", text_size = size.small)
    table.cell(dash, 5, 5, str.tostring(strategy.equity, "#"), text_size = size.small)

    table.cell(dash, 0, 6, "New entries", text_size = size.small)
    table.cell(dash, 1, 6, entriesBlocked ? "BLOCKED" : "OK", text_size = size.small, bgcolor = entriesBlocked ? color.new(color.red, 60) : color.new(color.green, 70))
    table.cell(dash, 2, 6, "Reason", text_size = size.small)
    table.cell(dash, 3, 6, blockReason, text_size = size.small)
    table.cell(dash, 4, 6, "Exits", text_size = size.small)
    table.cell(dash, 5, 6, "ALWAYS ACTIVE", text_size = size.small, bgcolor = color.new(color.green, 70))

    table.cell(dash, 0, 7, "Assumed cost", text_size = size.small)
    table.cell(dash, 1, 7, "spr " + str.tostring(infoSpread, "#.##"), text_size = size.small)
    table.cell(dash, 2, 7, "slip " + str.tostring(infoSlipTicks * syminfo.mintick, "#.###"), text_size = size.small)
    table.cell(dash, 3, 7, "comm " + str.tostring(infoCommOz, "#.###"), text_size = size.small)
    table.cell(dash, 4, 7, "mintick", text_size = size.small)
    table.cell(dash, 5, 7, str.tostring(syminfo.mintick), text_size = size.small)


// =============================================================================================
// 8. DEBUG EXPORT
//    Every series below is written into the chart's data window (and into the CSV that
//    "Export chart data..." produces) when the Debug export input is on. Nothing here
//    affects order flow.
//
//    REASON CODES - a wire format shared with msvsd/__init__.py. Append, never renumber.
//        0  NONE
//        1  ENTRY_LONG
//        2  ENTRY_SHORT
//        3  EXIT_CHANNEL
//        4  EXIT_PROTECTIVE_STOP
//        5  EXIT_SLEEVE_DISABLED
//        6  EXIT_DIRECTION_MODE          (Python-side challenger mode; never emitted here)
//        7  EXIT_END_OF_DATA
//        8  EXIT_STOP_GAP                (Python-side LTF replay; never emitted here)
//    When a bar carries both an exit and a new entry, the ENTRY code is reported - the
//    Python engine resolves the collision the same way.
//
//    STATE CODES:  1 = LONG, 0 = FLAT, -1 = SHORT
// =============================================================================================
dbgReasonFast = fNev != 0 ? fNev : fXev
dbgReasonMed  = mNev != 0 ? mNev : mXev
dbgReasonSlow = sNev != 0 ? sNev : sXev

plot(dbgOn ? atrVal                        : na, "dbg_atr",            display = display.data_window)

plot(dbgOn ? fDir                          : na, "dbg_state_fast",     display = display.data_window)
plot(dbgOn ? mDir                          : na, "dbg_state_medium",   display = display.data_window)
plot(dbgOn ? sDir                          : na, "dbg_state_slow",     display = display.data_window)

plot(dbgOn ? fDir * fLots                  : na, "dbg_qty_fast",       display = display.data_window)
plot(dbgOn ? mDir * mLots                  : na, "dbg_qty_medium",     display = display.data_window)
plot(dbgOn ? sDir * sLots                  : na, "dbg_qty_slow",       display = display.data_window)

plot(dbgOn ? fStop                         : na, "dbg_stop_fast",      display = display.data_window)
plot(dbgOn ? mStop                         : na, "dbg_stop_medium",    display = display.data_window)
plot(dbgOn ? sStop                         : na, "dbg_stop_slow",      display = display.data_window)

plot(dbgOn ? netLots                       : na, "dbg_net_target_lots", display = display.data_window)
plot(dbgOn ? strategy.position_size / contractOz : na, "dbg_position_lots", display = display.data_window)

plot(dbgOn ? dbgReasonFast                 : na, "dbg_reason_fast",    display = display.data_window)
plot(dbgOn ? dbgReasonMed                  : na, "dbg_reason_medium",  display = display.data_window)
plot(dbgOn ? dbgReasonSlow                 : na, "dbg_reason_slow",    display = display.data_window)

plot(dbgOn ? fEntHi : na, "dbg_ent_hi_fast",   display = display.data_window)
plot(dbgOn ? fEntLo : na, "dbg_ent_lo_fast",   display = display.data_window)
plot(dbgOn ? fExHi  : na, "dbg_exit_hi_fast",  display = display.data_window)
plot(dbgOn ? fExLo  : na, "dbg_exit_lo_fast",  display = display.data_window)
plot(dbgOn ? mEntHi : na, "dbg_ent_hi_medium", display = display.data_window)
plot(dbgOn ? mEntLo : na, "dbg_ent_lo_medium", display = display.data_window)
plot(dbgOn ? mExHi  : na, "dbg_exit_hi_medium", display = display.data_window)
plot(dbgOn ? mExLo  : na, "dbg_exit_lo_medium", display = display.data_window)
plot(dbgOn ? sEntHi : na, "dbg_ent_hi_slow",   display = display.data_window)
plot(dbgOn ? sEntLo : na, "dbg_ent_lo_slow",   display = display.data_window)
plot(dbgOn ? sExHi  : na, "dbg_exit_hi_slow",  display = display.data_window)
plot(dbgOn ? sExLo  : na, "dbg_exit_lo_slow",  display = display.data_window)

// strategy.equity carries no financing - TradingView models none - so this is the
// series the Python reconciler compares against its own equity minus cumulative swap.
plot(dbgOn ? strategy.equity : na, "dbg_equity_ex_financing", display = display.data_window)
