//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// Scalp_Gold_M1 — corrected Pine v5 implementation  (rev.2)
// XAUUSD / 1-minute
//
// This is Scalp_Gold_M1_fixed.pine with four defects repaired.  The intent is
// unchanged; only the places where the code did not express the intent moved.
// The reference semantics are core/backtest.py in this repository, which has
// already been reconciled against the MT5 Strategy Tester (178/178 trades).
//
// WHAT CHANGED, AND WHY
// ─────────────────────
// [1] var int lastSignalBar/lastFillBar were initialised to `na`, and the entry
//     gate tested `lastSignalBar != bar_index`.  A comparison against `na` does
//     not reliably yield `true` in Pine, and lastSignalBar is only ever assigned
//     INSIDE the branch that gate guards - so if the comparison is falsy the
//     gate can never open and the strategy takes ZERO trades, forever.
//     Fixed by seeding both with -1, which is a real int and can never collide
//     with a bar_index.  This is the defect that stops it trading at all.
//
// [2] The peak/trailing block ran on every script execution, including the
//     mid-bar re-run caused by calc_on_order_fills=true.  `high`/`low` are then
//     read from a bar that has not closed, so the trail could arm one bar early
//     off a still-forming extreme - which no broker, and neither the Python nor
//     the MQ5 engine, can reproduce.  The comment above it already said "only
//     the now-closed M1 bar", but nothing enforced it.
//     Fixed by guarding the peak/trail update with barstate.isconfirmed.
//     The SL *initialisation* deliberately stays outside that guard: anchoring
//     the stop to the actual fill price is exactly what calc_on_order_fills is
//     there for, and the stop must be live for the remainder of the fill bar.
//
// [3] use_bar_magnifier=true resolves intrabar fills from lower-timeframe data.
//     The Python engine and the generated EA both trigger SL from the bar's
//     high/low, so the magnifier makes TradingView disagree with them by
//     construction.  (It is also a Premium-plan feature, so the backtest was
//     not reproducible on other plans.)  Set to false.
//
// [4] State cleanup only ever released the single most recently closed trade,
//     and re-ran that same removal on every subsequent bar.  Replaced with a
//     drain that releases every trade closed since the last check.
//
// UNCHANGED BY DESIGN
// ───────────────────
//   • Signal is evaluated only at the M1 close; market entry fills next open.
//   • SL distance is frozen from the SIGNAL bar, SL price anchored to the FILL.
//   • H1 trend uses the LAST CLOSED H1 EMA only (request.security + [1]).
//   • The trail arms off the best price of a CLOSED bar and the resulting stop
//     is active from the FOLLOWING bar - identical to update_trail() in
//     core/backtest.py, which evaluates bar i using bar i-1's extreme.
//
// NOTE ON COSTS
//   commission_value stays 0.0 and Pine cannot model swap at all.  Compare
//   TradingView's GROSS figures against the Python engine's gross; swap and
//   commission are booked separately by the reconciler (report section 2b).
//
// NOTE ON RISK
//   FixedLossUSD is a TARGET for a stop filled at its stop price.  It is NOT a
//   hard loss cap - a gap through the stop can still realise a larger loss.
// ─────────────────────────────────────────────────────────────────────────────
strategy("Scalp Gold M1 (BB mean-reversion) — corrected rev.2",
     overlay = true,
     pyramiding = 20,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     initial_capital = 10000,
     currency = currency.USD,
     calc_on_every_tick = false,
     calc_on_order_fills = true,
     process_orders_on_close = false,
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 0.0,
     slippage = 0,
     close_entries_rule = "ANY",
     use_bar_magnifier = false)

// ── Inputs ───────────────────────────────────────────────────────────────────
FixedLossUSD     = input.float(5.0, "Target loss at SL (USD, gap risk not bounded)", group="Risk", step=0.5, minval=0.0)
TrailStartUSD    = input.float(3.0, "Start trailing once peak profit ≥ USD", group="Risk", step=0.5, minval=0.0)
TrailStepUSD     = input.float(1.0, "Lock (peak − step) USD after activation", group="Risk", step=0.5, minval=0.0)
AtrMultSL        = input.float(3.0, "SL distance = ATR × this", group="Risk", step=0.1, minval=0.1)
MinSlTicks       = input.int(50, "SL floor in ticks", group="Risk", minval=1)
QtyStep          = input.float(1.0, "Quantity step (units/oz)", group="Risk", step=0.01, minval=0.01)
MinQty           = input.float(1.0, "Minimum quantity (units/oz)", group="Risk", step=0.01, minval=0.01)
BBPeriod         = input.int(14, "Bollinger period (M1)", group="Signal", minval=2)
BBDeviation      = input.float(1.0, "Bollinger std-dev multiplier", group="Signal", step=0.1, minval=0.1)
AtrPeriod        = input.int(14, "ATR period (M1)", group="Signal", minval=2)
CooldownSec      = input.int(5, "Cooldown after close (sec)", group="Signal", minval=0)
BBMeanReversion  = input.bool(true, "Mean-reversion (pullback to band)", group="Signal")
MaxPositions     = input.int(1, "Max concurrent positions (pyramiding)", group="Signal", minval=1, maxval=20)
UseH1Trend       = input.bool(true, "Only trade with H1 EMA direction", group="Filters")
H1TrendPeriod    = input.int(50, "H1 EMA period", group="Filters", minval=2)
UseVolFilter     = input.bool(true, "Skip when ATR/price < MinAtrPct", group="Filters")
MinAtrPct        = input.float(0.015, "Minimum ATR as % of price", group="Filters", step=0.005, minval=0.0)
UseSessionFilter = input.bool(true, "Trade only during session", group="Filters")
SessionStartUTC  = input.int(13, "Session start hour (UTC, inclusive)", group="Filters", minval=0, maxval=23)
SessionEndUTC    = input.int(21, "Session end hour (UTC, exclusive)", group="Filters", minval=0, maxval=23)
UseBlackout      = input.bool(true, "Skip during US data-release blackouts", group="Filters")
BlackoutsUTC     = input.string("12:25-13:30,13:55-14:10,17:55-19:30", "Blackout windows (UTC, comma-separated HH:MM-HH:MM)", group="Filters")

// ── Helpers ──────────────────────────────────────────────────────────────────
parseBlackoutsToMin(string s) =>
    arr = array.new<int>()
    if not na(s) and str.length(s) > 0
        ranges = str.split(s, ",")
        n = array.size(ranges)
        if n > 0
            for i = 0 to n - 1
                rr = str.replace_all(array.get(ranges, i), " ", "")
                parts = str.split(rr, "-")
                if array.size(parts) == 2
                    sp = str.split(array.get(parts, 0), ":")
                    ep = str.split(array.get(parts, 1), ":")
                    if array.size(sp) == 2 and array.size(ep) == 2
                        sh = str.tonumber(array.get(sp, 0))
                        sm = str.tonumber(array.get(sp, 1))
                        eh = str.tonumber(array.get(ep, 0))
                        em = str.tonumber(array.get(ep, 1))
                        if not na(sh) and not na(sm) and not na(eh) and not na(em) and sh >= 0 and sh <= 23 and eh >= 0 and eh <= 23 and sm >= 0 and sm <= 59 and em >= 0 and em <= 59
                            array.push(arr, int(sh) * 60 + int(sm))
                            array.push(arr, int(eh) * 60 + int(em))
    arr

inHourWindow(int h, int startH, int endH) =>
    startH == endH ? true : startH < endH ? (h >= startH and h < endH) : (h >= startH or h < endH)

// ── Indicators ───────────────────────────────────────────────────────────────
bbBasis = ta.sma(close, BBPeriod)
bbDev   = BBDeviation * ta.stdev(close, BBPeriod)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
atrM1   = ta.atr(AtrPeriod)

// Always use the EMA belonging to the previous, fully closed H1 bar.
// The [1] is inside request.security(), and lookahead_on makes that confirmed
// HTF value available consistently across all M1 bars belonging to the next H1.
h1Ema = request.security(syminfo.tickerid, "60", ta.ema(close, H1TrendPeriod)[1], lookahead=barmerge.lookahead_on)

// ── Signal ───────────────────────────────────────────────────────────────────
// Mean-reversion: a close that pierces the LOWER band is a LONG (buy the dip).
crossUp = BBMeanReversion ?
     (close < bbLower and close[1] >= bbLower[1]) :
     (close > bbUpper and close[1] <= bbUpper[1])

crossDown = BBMeanReversion ?
     (close > bbUpper and close[1] <= bbUpper[1]) :
     (close < bbLower and close[1] >= bbLower[1])

// ── Filters ──────────────────────────────────────────────────────────────────
volOK = not UseVolFilter or (close > 0 and (atrM1 / close) * 100.0 >= MinAtrPct)
uptrend = not UseH1Trend or close > h1Ema
downtrend = not UseH1Trend or close < h1Ema

hUtc = hour(time, "UTC")
minOfDay = hUtc * 60 + minute(time, "UTC")
inSession = not UseSessionFilter or inHourWindow(hUtc, SessionStartUTC, SessionEndUTC)

var array<int> blackoutMins = parseBlackoutsToMin(BlackoutsUTC)
inBlackout = false
if UseBlackout
    bz = array.size(blackoutMins)
    if bz >= 2
        bi = 0
        while bi < bz - 1 and not inBlackout
            bs = array.get(blackoutMins, bi)
            be = array.get(blackoutMins, bi + 1)
            inBlackout := bs <= be ? (minOfDay >= bs and minOfDay < be) : (minOfDay >= bs or minOfDay < be)
            bi += 2

// ── Cooldown ─────────────────────────────────────────────────────────────────
var int lastCloseTime = 0
if strategy.closedtrades > 0
    t = strategy.closedtrades.exit_time(strategy.closedtrades - 1)
    if t > lastCloseTime
        lastCloseTime := t
inCooldown = lastCloseTime > 0 and time - lastCloseTime < CooldownSec * 1000

// ── Position sizing ──────────────────────────────────────────────────────────
// Risk per unit = price distance × syminfo.pointvalue.
// For a typical XAUUSD CFD where 1 oz × $1 move = $1, pointvalue = 1.
tickSize = syminfo.mintick
slFloor = MinSlTicks * tickSize
slDistSignal = math.max(AtrMultSL * atrM1, slFloor)
riskPerUnit = slDistSignal * syminfo.pointvalue
rawQty = riskPerUnit > 0 ? FixedLossUSD / riskPerUnit : 0.0
qtyUnits = math.floor(rawQty / QtyStep) * QtyStep
canSize = qtyUnits >= MinQty

// ── Per-entry state ──────────────────────────────────────────────────────────
var int tradeSeq = 0

// [1] FIX: seeded with -1, not na.  `na != bar_index` is not dependably true in
// Pine, and because lastSignalBar is assigned only inside the branch this gate
// guards, a falsy comparison here latches the strategy shut permanently.
// -1 is a real int that no bar_index can ever equal.
var int lastSignalBar = -1
var int lastFillBar = -1

var int prevOpenTrades = 0
var int prevClosedTrades = 0

// Stored at signal time. These values are NOT recomputed after the entry fills.
var map<string, float> slDistMap = map.new<string, float>()
var map<string, float> stopMap = map.new<string, float>()
var map<string, float> peakMap = map.new<string, float>()

// A fill-triggered recalculation must never create another entry based on the
// current historical bar's OHLC. Detect fills and block entries for that bar.
// This is also what forbids re-entry on the bar a position CLOSED on, matching
// "no re-entry on the same bar as an exit" in the Python engine.
fillEvent = strategy.opentrades != prevOpenTrades or strategy.closedtrades != prevClosedTrades
if fillEvent
    lastFillBar := bar_index
prevOpenTrades := strategy.opentrades
prevClosedTrades := strategy.closedtrades

// Only the normal bar-close execution is allowed to generate a new signal.
canSignalThisBar = barstate.isconfirmed and lastSignalBar != bar_index and lastFillBar != bar_index
canEnter = canSignalThisBar and not inCooldown and canSize and volOK and inSession and not inBlackout and strategy.opentrades < MaxPositions and atrM1 > 0

longSig = canEnter and crossUp and uptrend
shortSig = canEnter and crossDown and downtrend

if longSig
    tradeSeq += 1
    eid = "L" + str.tostring(tradeSeq)
    lastSignalBar := bar_index
    strategy.entry(eid, strategy.long, qty=qtyUnits, comment="M1 scalp up")
    map.put(slDistMap, eid, slDistSignal)

if shortSig
    tradeSeq += 1
    eid = "S" + str.tostring(tradeSeq)
    lastSignalBar := bar_index
    strategy.entry(eid, strategy.short, qty=qtyUnits, comment="M1 scalp down")
    map.put(slDistMap, eid, slDistSignal)

// ── Initial SL + per-position trailing ───────────────────────────────────────
if strategy.opentrades > 0
    for i = 0 to strategy.opentrades - 1
        eid = strategy.opentrades.entry_id(i)
        entryPrice = strategy.opentrades.entry_price(i)
        size = strategy.opentrades.size(i)
        absSize = math.abs(size)
        isLong = size > 0

        if absSize > 0 and map.contains(slDistMap, eid)
            dist = map.get(slDistMap, eid)

            // Initialise from the ACTUAL fill price.  Intentionally NOT guarded
            // by barstate.isconfirmed: this must run on the fill-triggered
            // execution so the stop is anchored to the real fill and is already
            // live for the remainder of the fill bar.  The Python engine
            // likewise allows a stop-out on the entry bar (bars_held = 0).
            if not map.contains(stopMap, eid)
                initSL = isLong ? entryPrice - dist : entryPrice + dist
                map.put(stopMap, eid, initSL)
                map.put(peakMap, eid, entryPrice)
                strategy.exit(eid + "_x", from_entry=eid, stop=initSL, comment="SL")

            // [2] FIX: the peak may only ever see a CLOSED bar.  Without this
            // guard the block also ran on the mid-bar calc_on_order_fills
            // execution, where high/low belong to a bar still forming - arming
            // the trail a bar early off an extreme no broker could have filled.
            //
            // Evaluating at the close of bar K and submitting the stop then
            // makes it active from bar K+1, which is exactly what
            // update_trail() in core/backtest.py does when it derives bar i's
            // stop from bar i-1's extreme.
            if barstate.isconfirmed
                prevPeak = map.get(peakMap, eid)
                newPeak = isLong ? math.max(prevPeak, high) : math.min(prevPeak, low)
                map.put(peakMap, eid, newPeak)

                peakProfitPrice = isLong ? (newPeak - entryPrice) : (entryPrice - newPeak)
                peakProfitUSD = peakProfitPrice * absSize * syminfo.pointvalue

                if peakProfitUSD >= TrailStartUSD and TrailStepUSD >= 0
                    lockUSD = math.max(peakProfitUSD - TrailStepUSD, 0.0)
                    lockDelta = absSize * syminfo.pointvalue > 0 ? lockUSD / (absSize * syminfo.pointvalue) : 0.0
                    newSL = isLong ? entryPrice + lockDelta : entryPrice - lockDelta
                    prevSL = map.get(stopMap, eid)
                    moveOK = isLong ? newSL > prevSL : newSL < prevSL
                    beyondEntry = isLong ? newSL > entryPrice : newSL < entryPrice

                    // [5] FIX: a broker REJECTS a stop that is already on the
                    // wrong side of the market - it would fire on the next tick.
                    // Pine has no such check and will happily hold a stop the
                    // market has already passed, then fill it at a price MT5
                    // never offered.  Measured against the reconciled MT5 run
                    // this was the single largest source of divergence: on a
                    // fast reversal TradingView locked in a profit that the
                    // broker would have refused, and every later trade shifted.
                    //
                    // core/backtest.py:202-217 applies the same guard against
                    // the next bar's opening bid/ask.  Pine cannot see that
                    // price without look-ahead, so the last confirmed close is
                    // used instead - on M1 the two differ only across the
                    // daily break.
                    notWrongSide = isLong ? (newSL < close) : (newSL > close)

                    if moveOK and beyondEntry and notWrongSide
                        map.put(stopMap, eid, newSL)
                        strategy.exit(eid + "_x", from_entry=eid, stop=newSL, comment="TSL")

// ── State cleanup ────────────────────────────────────────────────────────────
// [4] FIX: drain every trade closed since the last check.  The previous version
// released only strategy.closedtrades - 1, and re-released that same id on every
// later bar, so any trade that closed while another was still open leaked its
// three map entries for the life of the script.
var int cleanedClosed = 0
if strategy.closedtrades > cleanedClosed
    for ci = cleanedClosed to strategy.closedtrades - 1
        cid = strategy.closedtrades.entry_id(ci)
        map.remove(slDistMap, cid)
        map.remove(stopMap, cid)
        map.remove(peakMap, cid)
    cleanedClosed := strategy.closedtrades

// ── Diagnostics ──────────────────────────────────────────────────────────────
// These plots are also the export surface: "Export chart data" writes one CSV
// column per plot, which is what reconciliation against core/backtest.py reads.
plot(bbBasis, "bb_basis", color=color.orange)
plot(bbUpper, "bb_upper", color=color.blue)
plot(bbLower, "bb_lower", color=color.blue)
plot(atrM1,   "atr", color=color.new(color.purple, 100))
plot(UseH1Trend ? h1Ema : na, "h1_ema", color=color.red)
plot(longSig ? 1 : 0,  "sig_long",  color=color.new(color.green, 100))
plot(shortSig ? 1 : 0, "sig_short", color=color.new(color.maroon, 100))

bgcolor(UseSessionFilter and not inSession ? color.new(color.gray, 92) : na, title="Out-of-session shade")
bgcolor(UseBlackout and inBlackout ? color.new(color.red, 88) : na, title="Blackout shade")

// Display a warning if the chart's point value differs from the XAUUSD
// assumption of $1 per price-unit per unit/oz.
var label pointValueLabel = na
if barstate.islast
    if not na(pointValueLabel)
        label.delete(pointValueLabel)
    pointValueLabel := label.new(bar_index, high, "pointvalue=" + str.tostring(syminfo.pointvalue), style=label.style_label_down, textcolor=color.white, color=color.gray)
