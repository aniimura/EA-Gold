//--- per-position entry snapshots ----------------------------------------
// A closing deal can reach OnTradeTransaction AFTER the next position has
// already opened, so reading the "current" globals at that moment logs the
// wrong entry.  Snapshots are therefore keyed by position id.
#define REC_N 8
long     g_rec_pid[REC_N];
string   g_rec_dir[REC_N];
datetime g_rec_time[REC_N];
double   g_rec_price[REC_N];
double   g_rec_sl[REC_N];
double   g_rec_tp[REC_N];
double   g_rec_atr[REC_N];
double   g_rec_spread[REC_N];
double   g_rec_lots[REC_N];
long     g_rec_bar[REC_N];
bool     g_rec_trailed[REC_N];
int      g_rec_next = 0;
int      g_cur_slot = -1;
long     g_pos_id      = 0;      // identifier of the open position
bool     g_closed_in_bar = false;// it was closed inside the bar now starting

int RecFind(long pid)
  {
   if(pid <= 0)
      return(-1);
   for(int i = 0; i < REC_N; i++)
      if(g_rec_pid[i] == pid)
         return(i);
   return(-1);
  }

int      g_fh_trades = INVALID_HANDLE;
int      g_fh_bars   = INVALID_HANDLE;

//========================= generated indicators ==========================
//--- bb_basis = SMA(14)
double Ind_bb_basis(int s)
  {
   double sum = 0.0;
   for(int j = 0; j < 14; j++)
      sum += g_rates[(s + j) + 1].close;
   return(sum / 14.0);
  }

//--- bb_dev = StdDev(14)
double Ind_bb_dev(int s)
  {
   double mean = 0.0;
   for(int j = 0; j < 14; j++)
      mean += g_rates[(s + j) + 1].close;
   mean /= 14.0;
   double acc = 0.0;
   for(int j = 0; j < 14; j++)
     {
      double d = g_rates[(s + j) + 1].close - mean;
      acc += d * d;
     }
   return(MathSqrt(acc / 14.0));
  }

//--- bb_upper = Expr('bb_basis + 1.0 * bb_dev')
double Ind_bb_upper(int s)
  {
   return((Ind_bb_basis((s) + 0) + (1.0 * Ind_bb_dev((s) + 0))));
  }

//--- bb_lower = Expr('bb_basis - 1.0 * bb_dev')
double Ind_bb_lower(int s)
  {
   return((Ind_bb_basis((s) + 0) - (1.0 * Ind_bb_dev((s) + 0))));
  }

//--- atr = ATR(14)
double Ind_atr(int s)
  {
   double a = 1.0 / 14.0;
   double seed = 0.0;
   for(int j = 0; j < 14; j++)
      seed += MathMax(g_rates[(s + 199 - j) + 1].high - g_rates[(s + 199 - j) + 1].low, MathMax(MathAbs(g_rates[(s + 199 - j) + 1].high - g_rates[(s + 199 - j) + 2].close), MathAbs(g_rates[(s + 199 - j) + 1].low - g_rates[(s + 199 - j) + 2].close)));
   seed /= 14.0;
   double e = seed;
   for(int k = 185; k >= 0; k--)
      e = a * (MathMax(g_rates[(s + k) + 1].high - g_rates[(s + k) + 1].low, MathMax(MathAbs(g_rates[(s + k) + 1].high - g_rates[(s + k) + 2].close), MathAbs(g_rates[(s + k) + 1].low - g_rates[(s + k) + 2].close)))) + (1.0 - a) * e;
   return(e);
  }

//--- h1_ema = HTF(EMA(50), H1)
double Ind_h1_ema_H1(int s)
  {
   double a = 2.0 / (50.0 + 1.0);
   double seed = 0.0;
   for(int j = 0; j < 50; j++)
      seed += g_rates_H1[(s + 299 - j) + 1].close;
   seed /= 50.0;
   double e = seed;
   for(int k = 249; k >= 0; k--)
      e = a * (g_rates_H1[(s + k) + 1].close) + (1.0 - a) * e;
   return(e);
  }

double Ind_h1_ema(int s)
  {
   // index of the H1 bar containing this bar; +1 inside the
   // helper then reads the previous, fully CLOSED one.
   int j = iBarShift(_Symbol, PERIOD_H1, g_rates[(s) + 1].time, false);
   if(j < 0)
      return(0.0);
   return(Ind_h1_ema_H1(j));
  }

