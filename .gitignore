# Regenerated by the pipeline - never worth versioning.
__pycache__/
*.pyc

# Bar caches and per-bar dumps: large, and re-downloadable from MT5.
data/*.pkl
results/*_py_bars.pkl
results/*_mt5_bars.csv
results/*.htm

# Local runs.
results/_run_*.log

# Local path overrides.
core/config_local.py

# Broker terminal binaries.
*.exe

# index.html is generated by `cli.py web` but IS committed - GitHub Pages
# serves it. It is self-contained, so nothing under results/ needs pushing.
!index.html

# v2 framework: same rule as above. xau-msvsd/index.html is self-contained, so
# only the small summaries needed to audit the published numbers are versioned.
results/v2/*_bars_debug.csv
results/v2/*_fills.csv
results/v2/*_financing.csv
results/v2/mt5_bars.csv
results/v2/exp_grid/
results/v2/exp_axes/
results/v2/exp_costs/
results/v2/exp_stops/
results/v2/grid_run.log
